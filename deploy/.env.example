# Copie para .env e preencha.  Gere cada segredo com:  openssl rand -hex 32

# Endereço público. Sem domínio próprio, use o IP do servidor com traços + .sslip.io
# (ex.: IP 129.146.10.20  →  129-146-10-20.sslip.io). O HTTPS sai automático e grátis.
DOMAIN=129-146-10-20.sslip.io

# NUNCA mude depois de imprimir provas: os QR Codes já impressos param de ser aceitos.
QR_SECRET=
AUTH_SECRET=

# Deixe true só até criar a(s) conta(s); depois mude para false e rode: docker compose up -d
ALLOW_REGISTRATION=true

# Quantos backups diários manter
BACKUP_KEEP=14
